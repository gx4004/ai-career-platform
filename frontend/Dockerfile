FROM node:22-slim AS build
RUN corepack enable && corepack prepare pnpm@10.30.3 --activate
WORKDIR /app
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile
COPY . .
ARG VITE_API_URL
ARG VITE_SENTRY_DSN
ARG VITE_CAPTCHA_SITE_KEY
ARG VITE_R7_ENTRY_CHOICE
ARG VITE_R7_SAMPLE_QUICKFILL
ARG VITE_R7_CONTEXT_CARRY
ARG VITE_R7_NEXT_BEST_ACTION
ARG VITE_R7_VALUE_SPECIFIC_SIGNUP
ARG VITE_R7_RESULTS_NUDGE
ARG VITE_R11_EVIDENCE_PROFILE_ENABLED
ARG VITE_R12_CV_STUDIO_ENABLED
ARG VITE_R13_CAMPAIGNS_ENABLED
ARG VITE_R14_DISCOVERY_ENABLED
ARG VITE_R15_QUEUE_ENABLED
ARG VITE_R16_SUBMISSION_FOUNDATION_ENABLED
ARG VITE_R17_DEVELOPMENT_LOOP_ENABLED
ENV VITE_API_URL=$VITE_API_URL
ENV VITE_SENTRY_DSN=$VITE_SENTRY_DSN
ENV VITE_CAPTCHA_SITE_KEY=$VITE_CAPTCHA_SITE_KEY
ENV VITE_R7_ENTRY_CHOICE=$VITE_R7_ENTRY_CHOICE
ENV VITE_R7_SAMPLE_QUICKFILL=$VITE_R7_SAMPLE_QUICKFILL
ENV VITE_R7_CONTEXT_CARRY=$VITE_R7_CONTEXT_CARRY
ENV VITE_R7_NEXT_BEST_ACTION=$VITE_R7_NEXT_BEST_ACTION
ENV VITE_R7_VALUE_SPECIFIC_SIGNUP=$VITE_R7_VALUE_SPECIFIC_SIGNUP
ENV VITE_R7_RESULTS_NUDGE=$VITE_R7_RESULTS_NUDGE
ENV VITE_R11_EVIDENCE_PROFILE_ENABLED=$VITE_R11_EVIDENCE_PROFILE_ENABLED
ENV VITE_R12_CV_STUDIO_ENABLED=$VITE_R12_CV_STUDIO_ENABLED
ENV VITE_R13_CAMPAIGNS_ENABLED=$VITE_R13_CAMPAIGNS_ENABLED
ENV VITE_R14_DISCOVERY_ENABLED=$VITE_R14_DISCOVERY_ENABLED
ENV VITE_R15_QUEUE_ENABLED=$VITE_R15_QUEUE_ENABLED
ENV VITE_R16_SUBMISSION_FOUNDATION_ENABLED=$VITE_R16_SUBMISSION_FOUNDATION_ENABLED
ENV VITE_R17_DEVELOPMENT_LOOP_ENABLED=$VITE_R17_DEVELOPMENT_LOOP_ENABLED
RUN pnpm build

FROM node:22-slim
WORKDIR /app
ARG VITE_API_URL
ARG VITE_SENTRY_DSN
ENV VITE_API_URL=$VITE_API_URL
ENV VITE_SENTRY_DSN=$VITE_SENTRY_DSN
COPY --from=build --chown=node:node /app/dist dist
COPY --from=build --chown=node:node /app/node_modules node_modules
COPY --from=build --chown=node:node /app/serve.mjs serve.mjs
EXPOSE 3000
ENV PORT=3000
USER node
CMD ["node", "serve.mjs"]
