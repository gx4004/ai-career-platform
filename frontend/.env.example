# API backend URL (optional — defaults to /api/v1 with reverse proxy)
# VITE_API_URL=http://localhost:8000/api/v1

# Enable only after the deployed domain and end-to-end TLS posture are verified.
SECURITY_HSTS_ENABLED=false

# Autopilot experiment (#325), local-only: shows "Fill the form for me" on approved
# queue cards. Needs the backend's AUTOPILOT_EXPERIMENT_ENABLED too, and only works
# when the backend runs on your own computer (it opens a browser there).
# VITE_AUTOPILOT_EXPERIMENT_ENABLED=true
