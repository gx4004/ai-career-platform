# API backend URL (optional — defaults to /api/v1 with reverse proxy)
# VITE_API_URL=http://localhost:8000/api/v1

# Enable only after the deployed domain and end-to-end TLS posture are verified.
SECURITY_HSTS_ENABLED=false

# R7 first-run/continuity candidates — dark-shipped, default OFF (see PRD #109).
# Each candidate is an independent on/off toggle flipped without a code change.
# Only the literal string "true" enables a flag; unset or anything else = off.
# R7 #110 — first-run entry choice (resume-first vs role-first landing CTA).
# VITE_R7_ENTRY_CHOICE=true
# R7 #111 — sample resume / sample job-description quick-fill (dropzone/job-import).
# VITE_R7_SAMPLE_QUICKFILL=true
# R7 #112 — context-carry field transparency + per-field clear (handoff banner).
# VITE_R7_CONTEXT_CARRY=true
