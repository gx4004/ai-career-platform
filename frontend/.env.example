# API backend URL (optional — defaults to /api/v1 with reverse proxy)
# VITE_API_URL=http://localhost:8000/api/v1

# Frontend error reporting stays inactive while unset. Do not set this until the
# staging scrubbing gate in D-117 has been verified.
# VITE_SENTRY_DSN=

# Public reCAPTCHA site key for the registration challenge. Required whenever the
# backend runs with CAPTCHA_ENABLED=true — the register form fails closed (and
# refuses to sign anyone up) when the backend advertises a challenge and no site
# key is configured here. The paired secret stays server-side (CAPTCHA_SECRET_KEY).
# VITE_CAPTCHA_SITE_KEY=

# Enable only after the deployed domain and end-to-end TLS posture are verified.
SECURITY_HSTS_ENABLED=false

# R7 first-run/continuity candidates — dark-shipped, default OFF (see PRD #109).
# Each candidate is an independent on/off toggle flipped without a code change.
# Only the literal string "true" enables a flag; unset or anything else = off.
# R7 #110 — first-run entry choice (resume-first vs role-first landing CTA).
# VITE_R7_ENTRY_CHOICE=true
# R7 #111 — sample resume / sample job-description quick-fill (dropzone/job-import).
# VITE_R7_SAMPLE_QUICKFILL=true
# R7 #112 — context-carry field transparency + per-field clear (handoff banner).
# VITE_R7_CONTEXT_CARRY=true
# R7 #113 — metadata-aware next-best-action suggestion after a completed result.
# VITE_R7_NEXT_BEST_ACTION=true
# R7 #114 — value-specific guest signup prompt after a completed result.
# VITE_R7_VALUE_SPECIFIC_SIGNUP=true
# R7 #115 — recent-result revisit nudge on dashboard/history surfaces.
# VITE_R7_RESULTS_NUDGE=true

# Provisional build-ahead outcomes — navigation and routes remain dark by
# default. The backend has matching authoritative flags; enable both sides only
# after the outcome and every upstream roadmap gate are accepted.
# VITE_R11_EVIDENCE_PROFILE_ENABLED=true
# VITE_R12_CV_STUDIO_ENABLED=true
# VITE_R13_CAMPAIGNS_ENABLED=true
# VITE_R14_DISCOVERY_ENABLED=true
# VITE_R15_QUEUE_ENABLED=true
# VITE_R16_SUBMISSION_FOUNDATION_ENABLED=true
# VITE_R17_DEVELOPMENT_LOOP_ENABLED=true
