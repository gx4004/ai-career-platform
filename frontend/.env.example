# API backend URL (optional — defaults to /api/v1 with reverse proxy)
# VITE_API_URL=http://localhost:8000/api/v1

# Frontend error reporting stays inactive while unset. Do not set this until the
# staging scrubbing gate in D-117 has been verified.
# VITE_SENTRY_DSN=

# Public reCAPTCHA site key for the registration challenge. Required whenever the
# backend runs with CAPTCHA_ENABLED=true — the register form fails closed (and
# refuses to sign anyone up) when the backend advertises a challenge and no site
# key is configured here. The paired secret stays server-side (CAPTCHA_SECRET_KEY).
# VITE_CAPTCHA_SITE_KEY=

# Enable only after the deployed domain and end-to-end TLS posture are verified.
SECURITY_HSTS_ENABLED=false

# Autopilot experiment (#325), local-only: shows "Fill the form for me" on approved
# queue cards. Needs the backend's AUTOPILOT_EXPERIMENT_ENABLED too, and only works
# when the backend runs on your own computer (it opens a browser there).
# VITE_AUTOPILOT_EXPERIMENT_ENABLED=true
