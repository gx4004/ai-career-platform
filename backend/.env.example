DATABASE_URL=sqlite:///./career_platform.db
SECRET_KEY=change-me-to-a-random-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# LLM_PROVIDER selects the AI backend:
#   vertex    — Vertex AI Gemini (production; needs GCP credentials below)
#   google    — Google Gen AI direct API (needs GOOGLE_API_KEY)
#   anthropic — Claude via the Anthropic API (needs ANTHROPIC_API_KEY below;
#               defaults to claude-haiku-4-5 unless LLM_MODEL/LLM_PRACTICE_MODEL
#               is set)
#   fake      — deterministic local fixtures, no network call and no API key.
#               Use this for local development/demo when Vertex isn't
#               configured: every tool returns realistic, schema-valid output.
LLM_PROVIDER=vertex
LLM_MODEL=gemini-2.5-flash
LLM_PRACTICE_MODEL=
GOOGLE_API_KEY=

VERTEX_PROJECT_ID=your-gcp-project-id
VERTEX_LOCATION=us-central1

# Required only when LLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=

CORS_ORIGINS=http://localhost:5173,http://localhost:3000
FRONTEND_URL=http://localhost:3000
ENVIRONMENT=development
TRUST_PROXY_HEADERS=false
TRUSTED_PROXY_CIDRS=
RATE_LIMIT_STORAGE_URI=memory://
RATE_LIMIT_KEY_PREFIX=career-workbench
ABUSE_IDENTITY_HMAC_KEY=
MODEL_COST_LIMIT=30/hour
MODEL_SOURCE_COST_LIMIT=60/hour
RESOURCE_IMPORT_LIMIT=60/hour
RESOURCE_SOURCE_LIMIT=120/hour
AUTH_FAILURE_WINDOW_SECONDS=900
AUTH_PROGRESSIVE_DELAY_AFTER=3
AUTH_PROGRESSIVE_DELAY_CAP_SECONDS=4.0
ACCOUNT_ACTION_WINDOW_SECONDS=3600
ACCOUNT_PROGRESSIVE_DELAY_AFTER=3
ACCOUNT_PROGRESSIVE_DELAY_CAP_SECONDS=2.0

RESULT_CACHE_TTL_SECONDS=3600
RESULT_CACHE_ENABLED=true
RESULT_CACHE_MAX_ENTRIES=512
BLENDED_SCORING_ENABLED=true
EVIDENCE_PROFILE_INJECTION_ENABLED=false

# Provisional build-ahead outcomes. Each flag is independent (#321): keep any
# given flag false until its own accepted roadmap gate has closed — no flag
# requires any other outcome's flag to also be true. For local development,
# setting all seven to true is the simplest way to exercise the full
# build-ahead surface.
R11_EVIDENCE_PROFILE_ENABLED=false
R12_CV_STUDIO_ENABLED=false
R13_CAMPAIGNS_ENABLED=false
R14_DISCOVERY_ENABLED=false
R15_QUEUE_ENABLED=false
R17_DEVELOPMENT_LOOP_ENABLED=false

# Recurring employer-ATS ingestion (Greenhouse/Lever/Ashby public job-board
# APIs, #323). Independent of R14_DISCOVERY_ENABLED; both must be true for the
# background scheduler to start network fetches. Ships dark.
ATS_INGESTION_ENABLED=false

# R10 operational evidence inputs. These defaults do not activate a response;
# the scorecard only reports evidence and review requirements.
API_REPLICA_CLASS=single
LATENCY_P95_BUDGET_MS=60000
COST_ALERT_USD_24H=5.0
# Set to the provisioned PostgreSQL capacity in bytes; 0 means unknown.
DB_CAPACITY_BYTES=0
# Provisional budgets (D-124); retune from observed operation. A wrong value
# costs one extra human review, never an action.
CACHE_HIT_RATIO_FLOOR=0.5
PROVIDER_AVAILABILITY_SLO_PCT=99.0
LOADER_ABANDONMENT_ELEVATION_FACTOR=2.0
DB_QUERY_P95_BUDGET_MS=250

CAPTCHA_ENABLED=false
CAPTCHA_SECRET_KEY=
CAPTCHA_VERIFY_URL=https://www.google.com/recaptcha/api/siteverify

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

RESEND_API_KEY=
PASSWORD_RESET_FROM_EMAIL=noreply@careerworkbench.com
PASSWORD_RESET_REPLY_TO=
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=60

DISPOSABLE_EMAIL_BLOCK_ENABLED=true
SENTRY_DSN=
