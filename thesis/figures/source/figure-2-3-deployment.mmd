flowchart TB
    classDef edge fill:#e3f2fd,stroke:#1565c0,stroke-width:2px,color:#000
    classDef railway fill:#f3e5f5,stroke:#6a1b9a,stroke-width:2px,color:#000
    classDef store fill:#fce4ec,stroke:#ad1457,stroke-width:2px,color:#000
    classDef external fill:#fff9c4,stroke:#827717,stroke-width:2px,color:#000
