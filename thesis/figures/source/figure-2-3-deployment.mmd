    User([Browser<br/>thecareerworkbench.com]):::edge

    subgraph Cloudflare [Cloudflare DNS + TLS]
        direction TB
        DNS[A record →<br/>Railway edge]:::edge
    end

    subgraph Railway [Railway project — single hostname, path-based routing]
        direction TB
        Edge[Edge proxy<br/>HTTPS termination]:::railway
        FE[Frontend service<br/>Vite SSR · pnpm build · Node 20]:::railway
        BE[Backend service<br/>FastAPI · uvicorn · Python 3.11]:::railway
        PG[(PostgreSQL add-on<br/>Railway-managed)]:::store
    end

    subgraph CloudExt [External cloud services]
        direction TB
        Vertex[Google Vertex AI<br/>Gemini 2.5 Flash]:::external
        Resend[Resend<br/>password-reset email]:::external
    end

    subgraph Observ [Observability]
        direction TB
        Sentry[Sentry free tier<br/>error tracking]:::obs
        Metrics[Railway metrics<br/>CPU · memory · request rate]:::obs
    end

    User --> DNS --> Edge
    Edge -- "/" path --> FE
    Edge -- "/api/v1/*" path --> BE
    BE --> PG
    BE -- LLM inference --> Vertex
    BE -- transactional email --> Resend
    BE -. errors .-> Sentry
    FE -. errors .-> Sentry
    BE -. metrics .-> Metrics
    FE -. metrics .-> Metrics
